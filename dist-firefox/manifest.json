{
  "browser_specific_settings": {
    "gecko": {
      "id": "bctoolbox@seles84",
      "strict_min_version": "121.0"
    }
  },
  "manifest_version": 3,
  "name": "BC Toolbox",
  "description": "Member lookup, chat logging and tools for Bondage Club",
  "version": "1.1.1",
  "icons": {
    "128": "bclub-logo.png"
  },
  "action": {
    "default_icon": "bclub-logo.png",
    "default_title": "BC Toolbox",
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "tabs",
    "downloads",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "https://www.bondageprojects.elementfx.com/*/BondageClub*",
    "https://www.bondage-europe.com/*/BondageClub*",
    "https://www.bondageprojects.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bondageprojects.elementfx.com/*/BondageClub*",
        "https://www.bondage-europe.com/*/BondageClub*",
        "https://www.bondageprojects.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://www.bondageprojects.elementfx.com/*",
        "https://www.bondage-europe.com/*",
        "https://www.bondageprojects.com/*"
      ],
      "resources": [
        "injected.js"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}