{
    "name": "bc-toolbox",
    "private": true,
    "type": "module",
    "version": "1.14.0",
    "description": "BC Toolbox - member lookup, chat logging and tools for Bondage Club",
    "scripts": {
        "dev": "node scripts/build.mjs --watch",
        "build": "node scripts/build.mjs",
        "build:firefox": "node scripts/build.mjs --firefox",
        "type-check": "vue-tsc --build",
        "lint": "eslint . --fix",
        "backup:project": "node scripts/backup-project.mjs",
        "release:patch": "yarn version --patch && yarn build && yarn backup:project",
        "release:minor": "yarn version --minor && yarn build && yarn backup:project",
        "release:major": "yarn version --major && yarn build && yarn backup:project"
    },
    "dependencies": {
        "bc-data": "^130.0.0",
        "bondage-club-mod-sdk": "^1.2.0",
        "dexie": "^4.0.11",
        "lz-string": "^1.5.0",
        "pinia": "^3.0.2",
        "reka-ui": "^2.3.0",
        "vue": "^3.5.16",
        "vue-router": "^4.5.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.1.8",
        "@types/chrome": "^0.0.326",
        "@vitejs/plugin-vue": "^5.2.4",
        "@vue/tsconfig": "^0.7.0",
        "bc-stubs": "^130.0.0",
        "eslint": "^10.8.0",
        "eslint-plugin-vue": "^10.10.0",
        "tailwindcss": "^4.1.8",
        "typescript": "~5.8.3",
        "typescript-eslint": "^8.66.0",
        "vite": "^6.3.5",
        "vue-eslint-parser": "^10.4.1",
        "vue-tsc": "^2.2.10"
    },
    "packageManager": "yarn@1.22.22",
    "repository": {
        "type": "git",
        "url": "https://github.com/Seles84/bc-toolbox.git"
    }
}
